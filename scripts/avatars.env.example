# Plantilla para generar avatares contra producción.
# Copia este fichero a  .env.avatars  (en la raíz del repo, gitignored) y rellena tus valores.
#
#   cp scripts/avatars.env.example .env.avatars
#
# Base de datos de PRODUCCIÓN (Postgres). Cógelo del panel de Render.
DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/NOMBRE_BD

# Media en S3 (para que los avatares se suban a tu bucket de producción).
USE_S3_MEDIA=true
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=TU_BUCKET
AWS_S3_REGION_NAME=eu-west-1

# Modelo de face-swap (opcional; por defecto ~/ai-image-gen/inswapper_128.onnx).
AVATAR_INSWAPPER=/Users/TU_USUARIO/ai-image-gen/inswapper_128.onnx
